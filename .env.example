# ── SecureFileGuard environment variables ────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# JWT signing secret – use a long random value in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-key

# JWT token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin account created on first startup
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
