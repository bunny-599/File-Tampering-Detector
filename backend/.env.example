# Copy this to .env and fill in your values before running in production.

# JWT signing secret – use a long random string, NEVER commit the real value
SECRET_KEY=replace-this-with-a-long-random-secret-key

# JWT token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin credentials created on first startup
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
